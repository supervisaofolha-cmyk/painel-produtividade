function attachTagRemove(id,name) {
  var array = $('attachTag_' + id + '_names').value.split(';');
  var names = '';
  var value;
  for (var i=0; i<array.length; i++) {
    value = trim(array[i]);
    if ((value.length>0) && (value!=name))
      names += value + ';';
  }
  $('attachTag_' + id + '_names').value = names;

  attachTagRefresh(id);
  attachFileInputTagRemove(id);
}

function attachFileInputTagRemove(id) {
  document.getElementById('attachTag_' + id + '_names').value = '';

  let authenticDocument = document.getElementById(`attachTag_${id}_authenticDocument`);
  if (authenticDocument !== null
          && authenticDocument !== undefined) {
    authenticDocument.value = 'false';
  }

  let authenticDocumentInfo = document.getElementById(`attachTag_${id}_info`);
  if (authenticDocumentInfo !== null
          && authenticDocumentInfo !== undefined) {
    setInfoAttachTag(id, '', '', '');
    authenticDocumentInfo.style.display = 'none';        
  }      
}

function validateAuthenticityDocument(id) {
  let authenticDocument = document.getElementById(`attachTag_${id}_validateAuthenticity`);

  let isValidadeAuthenticity = authenticDocument !== null && authenticDocument !== undefined && authenticDocument.value === 'true';

  if(isValidadeAuthenticity) {
    let authenticDocument = document.getElementById(`attachTag_${id}_authenticDocument`);
    let authenticDocumentMessage = document.getElementById(`attachTag_${id}_authenticDocumentMessage`);        
    let validatingDocument = document.getElementById(`attachTag_${id}_validatingDocument`);        
        
    authenticDocument.value = 'false';
    validatingDocument.value = 'true';
    authenticDocumentMessage.value = 'Por favor, aguarde a validaÁ„o terminar.';
            
    setInfoAttachTag(id, '/imagens/busy.gif', 'Validando autenticidade do documento. Por favor aguarde!', '');
      
    let names = document.getElementById(`attachTag_${id}_names`).value;
    let documentType = document.getElementById(`attachTag_${id}_documentType`).value;
        
    let param = {
          id: id,
          names: names,
          documentType: documentType
      };
        
    let json = JSON.stringify(param);
                      
    jsfInvoke('autenticidadeDocumentoBean.setValidarAnexo', json, new Function('param','setStatusAutenticidadeDocumento(param)'));                
  }    
}

function setStatusAutenticidadeDocumento(param) {
  let response = JSON.parse(param);
  let authenticDocument = document.getElementById(`attachTag_${response.id}_authenticDocument`);
  let validatingDocument = document.getElementById(`attachTag_${response.id}_validatingDocument`); 
   
  let authenticDocumentMessage = document.getElementById(`attachTag_${response.id}_authenticDocumentMessage`);
  authenticDocumentMessage.value = '';
  validatingDocument.value = 'false';
    
  if (response.error === true) {
    img = '/imagens/warning.png';
    setInfoAttachTag(response.id, img, 'Falha inesperada ao v·lidar arquivo.');
    authenticDocument.value = 'false';
  } else {        
    let img;                
        
    if(response.authenticated === true) {
      img = '/imagens/check.png';
      authenticDocument.value = 'true';
    } else {
      img = '/imagens/warning_triangle.png';
      authenticDocument.value = 'false';
    }
                
    let result = response.files.reduce((acc, file) => {
      return acc + `${file.reason} `;
    }, '');   
    
    let validScores = response.files
        .map(file => file.score)
        .filter(score => score !== null && score !== undefined);

    let minScore = validScores.length > 0 ? Math.min(...validScores) : 0;
                    
    setInfoAttachTag(response.id, img, result, minScore);
  }
}

function setInfoAttachTag(id, img, message, score) {
  let attachTagInfo = document.getElementById(`attachTag_${id}_info`);
  let attachTagImg = document.getElementById(`attachTag_${id}_img`);
  let attachTagImgString = document.getElementById(`attachTag_${id}_imagemValidacaoPlugStr`);
  let attachTagDocumentMessage = document.getElementById(`attachTag_${id}_authenticDocumentMessage`);
  let attachTagInfoMessage = document.getElementById(`attachTag_${id}_info_message`);
  let attachTagScore = document.getElementById(`attachTag_${id}_scoreDocument`);
  let attachTagScoreMessage = document.getElementById(`attachTag_${id}_score_message`);

  if(attachTagInfo !== null 
          && attachTagInfo !== undefined
          && attachTagImg !== null 
          && attachTagImg !== undefined
          && attachTagImgString !== null 
          && attachTagImgString !== undefined  
          && attachTagDocumentMessage !== null 
          && attachTagDocumentMessage !== undefined  
          && attachTagInfoMessage !== null 
          && attachTagInfoMessage !== undefined  
          && attachTagScore !== null
          && attachTagScore !== undefined
          && attachTagScoreMessage !== null
          && attachTagScoreMessage !== undefined) {
    attachTagImg.src = img;
    attachTagImgString.value = img;
    attachTagDocumentMessage.value = message;
    attachTagInfoMessage.innerText = message;
    attachTagInfo.style.display = 'block';
    attachTagScore.value = score;
    if(score !== null
            && score !== undefined
