  var names = $('attachTag_' + id + '_names').value;
  var textLabel = $('attachTag_' + id + '_textLabel').value;
  var hrefs = $('attachTag_' + id + '_hrefs').value;
  var array = names.split(';');
  var hrefArray = '';
  
  if (hrefs !== 'undefined' && hrefs !== '') {
    hrefArray = hrefs.split(';');
  }
  
  var empty = true;
  for (var i=0; i<array.length; i++) {
    value = trim(array[i]);
    var hrefValue='';
    
    if (hrefArray[i]) {
     hrefValue =  trim(hrefArray[i]);
    }
    if (value.length>0) {
      if (!empty) html += '<br/>';
      html += '<a href="#" name="attachTagRemove" onclick="attachTagRemove(\'' + id + '\',\'' + value + '\'); return false;"><img src="/imagens/ico_deletar.gif" title="Remover anexo" alt="Remover" border="0"/></a>&nbsp;';
      
    if (hrefValue !== 'undefined' && hrefValue !== '' && hrefValue.includes(value)) {
        html += '<a id="' + value + '" href="' + hrefValue + '" target="_blank">' + value + '</a>';
    } else {
        html += value;
    }      
    empty = false;
    }
  }

  if ((names.length==0) || (multi)) {
    if (!empty)
      html += '</td><td width="20"></td><td>';
    html += '<input type="button" name='+ id +' value="' + textLabel + '" onclick="novaJanela(\'/comum/faces/AttachTagPopup.html?id=' + id + '&fieldId=' + id + '&uriOrigem=' + encodeURIComponent(window.location.pathname) + '&size=' + size + '&typeNotPermitted=' + typeNotPermitted + '&typePermitted=' + typePermitted + '\',\'attachTag_' + id + '\',500,210);" class="commandButton"/>';
