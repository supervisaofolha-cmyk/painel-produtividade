  });
}

function serieMask(campo) {
  if (campo==null) return;
  
    jQuery(function($){
        var serieOptions = { placeholder: " " };
        var serieMasks = ["?999.9999.99999-999", "?999.9999.9999999-9"];
        
        if (jQuery(campo).val().replace(/\D/g, '').length > 13) {
            jQuery(campo).mask(serieMasks[1], serieOptions );
        } else {
            jQuery(campo).mask(serieMasks[0], serieOptions );
        }
        
        jQuery(campo).keyup(function (event) {
            var serie, element;
            element = jQuery(this);
            serie = element.val().replace(/\D/g, '');
            var maskSerie = (serie.length > 13) ? serieMasks[1] : serieMasks[0];
            element.unmask();
            element.mask(maskSerie, serieOptions);
        });
    });
}

function apenasNumeros(campo) {
  jQuery(campo).keypress(function (e) { return onlyNumber(e); });
}

function onlyNumber(e){
  var keycode = (e.keyCode ? e.keyCode : e.which);
  //   Backspace        Enter             Tab              Del                      Del                                ctrl+c                          ctrl+v                          Arrows                         Numbers
  if ((keycode==8)|| (keycode==13) || (keycode==9) || (keycode==127) || (e.keyCode==46 && e.which==0) || (e.keyCode==0 && e.which==99) || (e.keyCode==0 && e.which==118) || (keycode>=37 && keycode<=40) || (keycode>=48 && keycode<=57))
    return true;
  return false;
}

 function apenasNumerosPositivos(id) {
