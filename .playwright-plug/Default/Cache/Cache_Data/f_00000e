function storeMainScroll() {
  storeMainScroll(0);
}

function storeMainScroll(index) {
  var mainScroll = document.getElementById('mainScroll');

  if (mainScroll==null) {
    mainScroll = document.getElementsByName('mainScroll');
    if ((mainScroll!=null) && (mainScroll.length>index))
      mainScroll = mainScroll.item(index);
  }

  if (mainScroll!=null)
    mainScroll.value = getCurrentScroll();
}

function getCurrentScroll() {
  var mainContent = document.documentElement;
  if (mainContent!=null)
    return String(Math.max(mainContent.scrollTop,document.body.scrollTop));
  else
    return String(document.body.scrollTop);
}

function atualizarGrupo(check,nomeGrupo) {
  if (check==null)
    return;

  var items = document.getElementsByName(nomeGrupo);
  if (items!=null) {
    for (var i=0; i<items.length; i++) {
      if (items[i].type!="checkbox")
        continue;

      if (!items[i].checked) {
        check.checked = null;
        return;
      }

      if (i+1==items.length)
        check.checked = "checked";
    }
  }
}

function marcarGrupo(check,nomeGrupo) {
  if (check==null)
    return;

  var items = document.getElementsByName(nomeGrupo);
  if (items!=null) {
    for (var i=0; i<items.length; i++) {
      if (items[i].type!="checkbox")
        continue;

      items[i].checked = check.checked;
    }
  }
}


