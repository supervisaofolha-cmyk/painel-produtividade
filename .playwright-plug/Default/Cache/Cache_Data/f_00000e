function forcaMaxlengthValoresComMascara(campo) {
    jQuery(function($) {
        var input = $(campo);
        var maxLength = parseInt(input.attr('maxlength') || 0);
        
        if (maxLength <= 0) return;
        
        input.on('keydown keypress', function(e) {
            //Permitir teclas de funÁ„o que usamos para atalhos: (F1-F12)
            if (e.key.startsWith('F') 
                    && !isNaN(parseInt(e.key.substr(1)))) {
                return true;
            }
            
            //Permitir tecla ESC
            if (e.key === 'Escape' 
                    || e.keyCode === 27) {
                return true;
            }
            
            //ObtÈm o valor sem formataÁ„o (apenas n˙meros):
            var rawValue = input.val().replace(/[^\d]/g, '');
            
            //Se o usu·rio estiver digitando um n˙mero e j· atingiu o limite:
